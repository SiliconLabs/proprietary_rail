project_name: rail_soc_range_test_gps_data_logging
label: Proprietary RAIL Examples - SoC Range Test with GPS data logging
package: Rail
description: >
  This application is a RAIL - SoC Range Test application with extended
  functionalities. This extension include GPS positioning and measurement data
  logging to an SD card.
category: RAIL Examples
quality: experimental

filter:
  - name: Wireless Technology
    value: [RAIL]
  - name: Device Type
    value: [SoC]
  - name: Project Difficulty
    value: [Advanced]

# UC/UP components
component:
  - id: sl_main
  - id: clock_manager
  - id: device_init
  - id: board_control
    condition: [hardware_board]
  - id: sl_rail_util_init
    instance:
      - inst0
  - id: rail_util_pa
  - id: sl_rail_sdk_packet_assistant
  - id: sl_rail_sdk_packet_asm
  - id: app_log
  - id: app_queue
  - id: app_assert
  # CLI
  - id: cli
    instance:
      - example
  - id: sl_rail_sdk_range_test_cli
  # LCD
  - id: glib
    condition:
      - hardware_board_supports_wstk_lcd
  # Images for LCD
  - id: sl_rail_sdk_images_for_lcd
    condition:
      - hardware_board_supports_wstk_lcd
  # VCOM
  - id: printf
  - id: iostream_recommended_stream
  - id: iostream_retarget_stdio
  # Memory Protection Unit
  - id: mpu
  # Core and Extension files
  - id: sl_rail_sdk_range_test_core
  # Restriction rules
  - id: restrictions_profile_base
  - id: restrictions_profile_connect
  - id: restrictions_profile_long_range
  - id: restrictions_profile_wisun_fan_1_0
  - id: restrictions_profile_wisun_fan_1_1
  - id: restrictions_profile_wisun_han
  - id: restrictions_profile_wisun_ofdm
  - id: restrictions_profile_connect_ofdm
  - id: restrictions_profile_sun
  - id: restrictions_profile_sidewalk
  # Series 3 OS
  - id: freertos
    condition: [device_series_3]
  # Code Classification
  - id: code_classification
  # GPS
  - id: iostream_eusart
    instance: [gps]
    condition: [device_generic_family_efr32xg22]
  - id: iostream_usart
    instance: [vcom]
    condition: [device_generic_family_efr32xg22]
  - id: iostream_eusart
    instance: [gps, vcom]
    condition: [device_generic_family_efr32xg23]
  - id: iostream_eusart
    instance: [gps, vcom]
    condition: [device_generic_family_efr32xg24]
  - id: iostream_eusart
    instance: [gps, vcom]
    condition: [device_generic_family_efr32xg25]
  - id: iostream_eusart
    instance: [gps, vcom]
    condition: [device_generic_family_efr32xg26]
  - id: iostream_usart
    instance: [gps]
    condition: [device_generic_family_efr32xg27]
  - id: iostream_eusart
    instance: [vcom]
    condition: [device_generic_family_efr32xg27]
  - id: iostream_eusart
    instance: [gps, vcom]
    condition: [device_generic_family_efr32xg28]
  # SD
  - id: spidrv
    instance: [microsd]
    condition: [device_generic_family_efr32xg22]
  - id: spidrv
    instance: [microsd]
    condition: [device_generic_family_efr32xg23]
  - id: spidrv
    instance: [microsd]
    condition: [device_generic_family_efr32xg24]
  - id: spidrv_eusart
    instance: [microsd]
    condition: [device_generic_family_efr32xg25]
  - id: spidrv
    instance: [microsd]
    condition: [device_generic_family_efr32xg26]
  - id: spidrv
    instance: [microsd]
    condition: [device_generic_family_efr32xg27]
  - id: spidrv_eusart
    instance: [microsd]
    condition: [device_generic_family_efr32xg28]
  # Extension
  - id: range_test_sd_log
    from: proprietary_extension
  - id: mikroe_gps
    from: third_party_hw_drivers
  - id: services_fatfs
    from: third_party_hw_drivers
  - id: sleeptimer

# Require list
requires:
  - name: a_radio_config
  - name: sl_rail_sdk_simple_os
    condition:
      - [kernel]
  - name: radio_config_simple_rail_singlephy
    condition: [device_generic_family_efr32xg22]
  - name: radio_config_simple_rail_singlephy
    condition: [device_generic_family_efr32xg24]
  - name: radio_config_simple_rail_singlephy
    condition: [device_generic_family_efr32xg25]
  - name: radio_config_simple_rail_singlephy
    condition: [device_generic_family_efr32xg26]
  - name: radio_config_simple_rail_singlephy
    condition: [device_generic_family_efr32xg27]
  - name: radio_config_simple_rail_singlephy
    condition: [device_generic_family_efr32xg28]
  - name: radio_config_simple_rail_singlephy
    condition: [device_generic_family_efr32xg29]
  - name: radio_config_range_test_sdid_210_868_915_phys
    condition: [device_generic_family_efr32xg23]
  - name: radio_config_singlephy_device_family_fgm23
    condition:
      - device_family_fgm23
  - name: radio_config_simple_rail_singlephy
    condition: [device_generic_family_efr32xg29]
  - name: radio_config_simple_rail_singlephy
    condition: [device_generic_family_sixx301]
  - name: simple_button
    condition:
      - hardware_board_supports_wstk_lcd

# Conflict list
conflicts:
  - name: simple_led

# Project files
readme:
  - path: ../README.md
include:
  - path: ../inc
    file_list:
      - path: gps_driver.h
      - path: sd_log_driver.h
source:
  - path: ../src/gps_driver.c
  - path: ../src/sd_log_driver.c
config_file:
  # GPS config files
  - path: ../config/sl_gps_driver_config.h
    file_id: gps_driver_config
  # xg22
  - path: ../config/efr32xg22/sl_iostream_eusart_gps_config.h
    override:
      component: iostream_eusart
      file_id: iostream_eusart_config
      instance: gps
    condition: [device_generic_family_efr32xg22]
  - path: ../config/efr32xg22/mikroe_gps_lea6s_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_gps"
      file_id: driver_config_gps_lea6s
    condition: [device_generic_family_efr32xg22]
  # xg23
  - path: ../config/efr32xg23/sl_iostream_eusart_gps_config.h
    override:
      component: iostream_eusart
      file_id: iostream_eusart_config
      instance: gps
    condition: [device_generic_family_efr32xg23]
  - path: ../config/efr32xg23/mikroe_gps_lea6s_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_gps"
      file_id: driver_config_gps_lea6s
    condition: [device_generic_family_efr32xg23]
  # xg24
  - path: ../config/efr32xg24/sl_iostream_eusart_gps_config.h
    override:
      component: iostream_eusart
      file_id: iostream_eusart_config
      instance: gps
    condition: [device_generic_family_efr32xg24]
  - path: ../config/efr32xg24/mikroe_gps_lea6s_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_gps"
      file_id: driver_config_gps_lea6s
    condition: [device_generic_family_efr32xg24]
  # xg25
  - path: ../config/efr32xg25/sl_iostream_eusart_gps_config.h
    override:
      component: iostream_eusart
      file_id: iostream_eusart_config
      instance: gps
    condition: [device_generic_family_efr32xg25]
  - path: ../config/efr32xg25/mikroe_gps_lea6s_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_gps"
      file_id: driver_config_gps_lea6s
    condition: [device_generic_family_efr32xg25]
  # xg27
  - path: ../config/efr32xg27/sl_iostream_usart_gps_config.h
    override:
      component: iostream_usart
      file_id: iostream_usart_config
      instance: gps
    condition: [device_generic_family_efr32xg27]
  - path: ../config/efr32xg27/mikroe_gps_lea6s_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_gps"
      file_id: driver_config_gps_lea6s
    condition: [device_generic_family_efr32xg27]
  # xg28
  - path: ../config/efr32xg28/sl_iostream_eusart_gps_config.h
    override:
      component: iostream_eusart
      file_id: iostream_eusart_config
      instance: gps
    condition: [device_generic_family_efr32xg28]
  - path: ../config/efr32xg28/mikroe_gps_lea6s_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_gps"
      file_id: driver_config_gps_lea6s
    condition: [device_generic_family_efr32xg28]
  # SD config files
  # xg22
  - path: ../config/efr32xg22/sl_spidrv_microsd_config.h
    override:
      component: spidrv
      file_id: spidrv_config
      instance: microsd
    condition: [device_generic_family_efr32xg22]
  - path: ../config/efr32xg22/mikroe_microsd_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_microsd"
      file_id: driver_config_microsd
    condition: [device_generic_family_efr32xg22]
  # xg23
  - path: ../config/efr32xg23/sl_spidrv_microsd_config.h
    override:
      component: spidrv
      file_id: spidrv_config
      instance: microsd
    condition: [device_generic_family_efr32xg23]
  - path: ../config/efr32xg23/mikroe_microsd_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_microsd"
      file_id: driver_config_microsd
    condition: [device_generic_family_efr32xg23]
  # xg24
  - path: ../config/efr32xg24/sl_spidrv_microsd_config.h
    override:
      component: spidrv
      file_id: spidrv_config
      instance: microsd
    condition: [device_generic_family_efr32xg24]
  - path: ../config/efr32xg24/mikroe_microsd_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_microsd"
      file_id: driver_config_microsd
    condition: [device_generic_family_efr32xg24]
  # xg25
  - path: ../config/efr32xg25/sl_spidrv_eusart_microsd_config.h
    override:
      component: spidrv_eusart
      file_id: spidrv_eusart_config
      instance: microsd
    condition: [device_generic_family_efr32xg25]
  - path: ../config/efr32xg25/mikroe_microsd_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_microsd"
      file_id: driver_config_microsd
    condition: [device_generic_family_efr32xg25]
  # xg27
  - path: ../config/efr32xg27/sl_spidrv_microsd_config.h
    override:
      component: spidrv
      file_id: spidrv_config
      instance: microsd
    condition: [device_generic_family_efr32xg27]
  - path: ../config/efr32xg27/mikroe_microsd_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_microsd"
      file_id: driver_config_microsd
    condition: [device_generic_family_efr32xg27]
  - path: ../config/efr32xg27/sl_iostream_eusart_vcom_config.h
    override:
      component: iostream_eusart
      file_id: iostream_eusart_config
      instance: vcom
    condition: [device_generic_family_efr32xg27]
  # xg28
  - path: ../config/efr32xg28/sl_spidrv_eusart_microsd_config.h
    override:
      component: spidrv_eusart
      file_id: spidrv_eusart_config
      instance: microsd
    condition: [device_generic_family_efr32xg28]
  - path: ../config/efr32xg28/mikroe_microsd_config.h
    override:
      component: "%extension-third_party_hw_drivers%mikroe_microsd"
      file_id: driver_config_microsd
    condition: [device_generic_family_efr32xg28]
other_file:
  - path: "hw_filter_tags.yaml"
    condition:
      - "add_hw_filter_to_project"

# Configuration overrides
configuration:
  # OS
  - name: OS_CFG_TMR_EN
    value: "1"
  - name: SL_STACK_SIZE
    value: "4096"
  # FreeRTOS OS
  - name: configMINIMAL_STACK_SIZE
    value: "1024"
  # Micrium OS / SystemView
  - name: CPU_CFG_TS_32_EN
    value: "1"
  - name: OS_CFG_DBG_EN
    value: "1"
  - name: OS_CFG_TS_EN
    value: "1"
  - name: OS_CFG_SCHED_ROUND_ROBIN_EN
    value: "1"
  - name: OS_CFG_STAT_TASK_EN
    value: "1"
  - name: OS_CFG_TASK_PROFILE_EN
    value: "1"
  # CLI
  - name: SL_CLI_EXAMPLE_TASK_STACK_SIZE
    value: "250"
  - name: SL_CLI_INPUT_BUFFER_SIZE
    value: "64"
  - name: SL_CLI_NUM_HISTORY_BYTES
    value: "0"
  - name: SL_CLI_EXAMPLE_TASK_PRIORITY
    value: "48"
  # RAIL init, Configuration
  - name: SL_RAIL_SDK_TX_FIFO_SIZE
    value: "128"
  - name: SL_RAIL_SDK_RX_FIFO_SIZE
    value: "256"
  # RAIL init, Project
  - name: SL_RAIL_UTIL_INIT_INIT_COMPLETE_CALLBACK_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_RADIO_CONFIG_SUPPORT_INST0_ENABLE
    value: "1"
  # RAIL init, Protocol
  - name: SL_RAIL_UTIL_INIT_PROTOCOLS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_PROTOCOL_INST0_DEFAULT
    value: "SL_RAIL_UTIL_PROTOCOL_PROPRIETARY"
  # Disable RAIL not needed protocols
  - name: SL_RAIL_UTIL_PROTOCOL_BLE_ENABLE
    value: "0"
  - name: SL_RAIL_UTIL_PROTOCOL_IEEE802154_2P4GHZ_ENABLE
    value: "0"
  - name: SL_RAIL_UTIL_PROTOCOL_IEEE802154_GB868_ENABLE
    value: "0"
  - name: SL_RAIL_UTIL_PROTOCOL_ZWAVE_ENABLE
    value: "0"
  - name: SL_RAIL_UTIL_PROTOCOL_SIDEWALK_ENABLE
    value: "0"
  # RAIL init, Calibrations
  - name: SL_RAIL_UTIL_INIT_CALIBRATIONS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_CALIBRATION_TEMPERATURE_NOTIFY_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_CALIBRATION_ONETIME_NOTIFY_INST0_ENABLE
    value: "1"
  # RAIL init, FIFOs
  - name: SL_RAIL_UTIL_INIT_RX_FIFO_INST0_BYTES
    value: "256"
  - name: SL_RAIL_UTIL_INIT_TX_FIFO_INST0_BYTES
    value: "256"
  # RAIL init, Auto Transitions
  - name: SL_RAIL_UTIL_INIT_TRANSITIONS_INST0_ENABLE
    value: "1"
  # RAIL init, Data Format
  - name: SL_RAIL_UTIL_INIT_DATA_FORMATS_INST0_ENABLE
    value: "1"
  # RAIL init, Radio Events
  - name: SL_RAIL_UTIL_INIT_EVENTS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_PACKET_RECEIVED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_FRAME_ERROR_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_TX_PACKET_SENT_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_TX_SCHEDULED_RX_TX_STARTED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_CAL_NEEDED_INST0_ENABLE
    value: "1"
  # RAIL init, PA
  - name: SL_RAIL_UTIL_PA_SELECTION_SUBGHZ
    value: "RAIL_TX_POWER_MODE_SUBGIG_POWERSETTING_TABLE"
    condition: [device_generic_family_efr32xg25]
  - name: SL_RAIL_UTIL_PA_SELECTION_OFDM
    condition: [device_generic_family_efr32xg25]
    value: "RAIL_TX_POWER_MODE_OFDM_PA_POWERSETTING_TABLE"
  # RFFPLL init
  - name: SL_CLOCK_MANAGER_RFFPLL_BAND
    value: "1"
    condition:
      - "device_generic_family_efr32xg25"
      - "hardware_board_default_rf_band_470"
  - name: SL_CLOCK_MANAGER_RFFPLL_BAND
    value: "0"
    condition:
      - "device_generic_family_efr32xg25"
      - "hardware_board_default_rf_band_450"
  # USART settings
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "(1)"
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: "usartHwFlowControlCtsAndRts"
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "(1)"
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS"
    condition:
      - device_series_2
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS"
    condition:
      - device_series_3
  # LCD settings
  - name: SL_BOARD_ENABLE_DISPLAY
    value: "1"
    condition:
      - dmd_memlcd
  # Button settings
  - name: SL_SIMPLE_BUTTON_BTN0_MODE
    value: "SL_SIMPLE_BUTTON_MODE_INTERRUPT"
  - name: SL_SIMPLE_BUTTON_BTN1_MODE
    value: "SL_SIMPLE_BUTTON_MODE_INTERRUPT"
  # Other project settings
  - name: APP_LOG_PREFIX_ENABLE
    value: "0"
  # Extension settings
  - name: SL_RAIL_UTIL_PTI_MODE
    value: "RAIL_PTI_MODE_DISABLED"
  - name: SL_CLI_EXAMPLE_IOSTREAM_HANDLE
    value: "sl_iostream_vcom_handle"
  - name: FF_FS_NORTC
    value: "1"

# Templates
template_contribution:
  - name: event_handler
    value:
      event: internal_app_init
      include: gps_driver.h
      handler: gps_handler_init
  - name: event_handler
    value:
      event: internal_app_process_action
      include: gps_driver.h
      handler: gps_handler_process
  - name: event_handler
    value:
      event: internal_app_init
      include: sd_log_driver.h
      handler: sd_init

# Toolchain
toolchain_settings:
  - option: optimize
    value: debug
ui_hints:
  highlight:
    - path: readme.md
    - path: config/rail/radio_settings.radioconf
      focus: true
sdk_extension:
  - id: third_party_hw_drivers
    version: 4.4.1
  - id: proprietary_extension
    version: 1.0.0
