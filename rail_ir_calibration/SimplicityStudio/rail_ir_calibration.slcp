# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: rail_ir_calibration
label: RAIL Proprietary - Image Rejection Calibration
package: Rail

description: >
  This example application demonstrates image rejection calibration in RAIL.

category: Proprietary RAIL Examples
quality: experimental

filter:
  - name: Device Type
    value: [SoC]
  - name: Project Difficulty
    value: [Beginner]
  - name: Wireless Technology
    value: [RAIL]

readme:
  - path: ../README.md

source:
  - path: ../src/app_init.c
  - path: ../src/app_process.c
  - path: ../src/app_cli.c

include:
  - path: "../inc"
    file_list:
      - path: app_init.h
      - path: app_process.h

toolchain_settings:
  - value: debug
    option: optimize

component:
  - id: app_log
  - id: app_assert
  - id: sl_main
  - id: iostream_retarget_stdio
  - id: iostream_recommended_stream
  - id: silabs_core_response_print
  - id: mpu
  - instance: [inst0]
    id: sl_rail_util_init
  - id: device_init
  - id: rail_util_recommended
  - id: rail_util_pa
  - instance: [inst]
    id: cli
  - id: nvm3_lib
  - id: nvm3_default
  - instance: [rx_active]
    id: sl_radioprs

template_contribution:
  - name: cli_command
    value:
      name: perform_ir_cal
      handler: cli_perform_ir_cal
      help: "Run sl_rail_calibrate_ir() on the current channel/config. With `iterate_all_phys` on, walks every channelConfigs[] entry."
  - name: cli_command
    value:
      name: get_pending_ir_cal
      handler: cli_get_pending_ir_cal
      help: "Get the pending IR calibration status for the current channel/config."
  - name: cli_command
    value:
      name: apply_ir_cal_values
      handler: cli_apply_ir_cal_values
      help: "Apply the given IR calibration values for the current config via sl_rail_apply_ir_calibration()."
      argument:
        - type: uint32opt
          help: "(rx_ir0) (rx_ir1) ((dc_offset_iq) (phi_epsilon) on FG25 OFDM-PA)"
  - name: cli_command
    value:
      name: get_ir_cal_values
      handler: cli_get_ir_cal_values
      help: "Get the active IR calibration values for the current config."
  - name: cli_command
    value:
      name: save_ir_cal_values
      handler: cli_save_ir_cal_values
      help: "Persist the current config's IR calibration values to NVM3."
  - name: cli_command
    value:
      name: load_ir_cal_values
      handler: cli_load_ir_cal_values
      help: "Load the current config's IR calibration values from NVM3 and apply them. The reported duration includes the NVM3 lookup/read so the production cost is visible."
  - name: cli_command
    value:
      name: status
      handler: cli_status
      help: "Print state, per-config slots and last-measured timings."
  - name: cli_command
    value:
      name: set_channel
      handler: cli_set_channel
      help: "Set the active channel within the current radio config."
      argument:
        - type: uint16
          help: "channel index"
  - name: cli_command
    value:
      name: get_channel
      handler: cli_get_channel
      help: "Get the active channel within the current radio config."
  - name: cli_command
    value:
      name: set_configindex
      handler: cli_set_configindex
      help: "Switch to channelConfigs[<index>] via sl_rail_config_channels()."
      argument:
        - type: uint8
          help: "config index"
  - name: cli_command
    value:
      name: get_configindex
      handler: cli_get_configindex
      help: "Print the active config index."
  - name: cli_command
    value:
      name: set_auto_ir_cal
      handler: cli_set_auto_ir_cal
      help: "When 1: CAL_NEEDED auto-runs sl_rail_calibrate_ir(). When 0: the event is logged but deferred until the user invokes `perform_ir_cal`."
      argument:
        - type: uint8
          help: "0=disable, 1=enable"
  - name: cli_command
    value:
      name: get_auto_ir_cal
      handler: cli_get_auto_ir_cal
      help: "Print the active auto_ir_cal setting."
  - name: cli_command
    value:
      name: set_iterate_all_phys
      handler: cli_set_iterate_all_phys
      help: "When 1: `perform_ir_cal` walks every channelConfigs[] entry (switching via sl_rail_config_channels) and calibrates each slot."
      argument:
        - type: uint8
          help: "0=disable, 1=enable"
  - name: cli_command
    value:
      name: get_iterate_all_phys
      handler: cli_get_iterate_all_phys
      help: "Print the active iterate_all_phys setting."
  - name: cli_command
    value:
      name: get_rssi
      handler: cli_get_rssi
      help: "Get RSSI on the active channel (image-frequency test helper)."
  - name: cli_command
    value:
      name: set_rf_path
      handler: cli_set_rf_path
      help: "Set the RF path."
      argument:
        - type: uint8
          help: "0=ANT0, 1=ANT1"
  - name: cli_command
    value:
      name: get_rf_path
      handler: cli_get_rf_path
      help: "Get the RF path."

provides:
  # primary PRS
  - name: primary_prs_group_2
    condition: [device_generic_family_efr32xg21]
  - name: primary_prs_group_1
    condition: [device_generic_family_efr32xg22]
  - name: primary_prs_group_0
    condition: [device_generic_family_efr32xg23]
  - name: primary_prs_group_0
    condition: [device_generic_family_efr32xg24]
  - name: primary_prs_group_1
    condition: [device_generic_family_efr32xg25]
  - name: primary_prs_group_0
    condition: [device_generic_family_efr32xg26]
  - name: primary_prs_group_2
    condition: [device_generic_family_efr32xg27]
  - name: primary_prs_group_0
    condition: [device_generic_family_efr32xg28]
  # EFR32xG22 exception list
  - name: primary_prs_group_2_ov
    condition: [brd4183b]
  - name: primary_prs_group_2_ov
    condition: [brd4183c]
  - name: primary_prs_group_2_ov
    condition: [brd4185a]
  - name: primary_prs_group_2_ov
    condition: [brd4183a]
  - name: primary_prs_group_2_ov
    condition: [brd4403b]
  - name: primary_prs_group_2_ov
    condition: [brd4191A]
  # EFR32xG27 exception list
  - name: primary_prs_group_1_ov
    condition: [brd4194a]

config_file:
  - path: ../config/efr32xg22/radio_settings.radioconf
    file_id: radio_configuration_settings
    directory: rail
    condition: [device_generic_family_efr32xg22]
  - path: ../config/efr32xg23/radio_settings.radioconf
    file_id: radio_configuration_settings
    directory: rail
    condition: [device_generic_family_efr32xg23]
  - path: ../config/efr32xg24/radio_settings.radioconf
    file_id: radio_configuration_settings
    directory: rail
    condition: [device_generic_family_efr32xg24]
  - path: ../config/efr32xg25/radio_settings.radioconf
    file_id: radio_configuration_settings
    directory: rail
    condition: [device_generic_family_efr32xg25]
  - path: ../config/efr32xg27/radio_settings.radioconf
    file_id: radio_configuration_settings
    directory: rail
    condition: [device_generic_family_efr32xg27]
  - path: ../config/efr32xg28/radio_settings.radioconf
    file_id: radio_configuration_settings
    directory: rail
    condition: [device_generic_family_efr32xg28]
  - path: ../config/sl_rail_ir_calibration_config.h

requires:
  - condition: [kernel]
    name: sl_simple_rail_os
  - condition: [hardware_board_has_eff]
    name: rail_util_eff
  - condition: [device_family_fgm23]
    name: radio_config_singlephy_device_family_fgm23

configuration:
  - name: SL_STACK_SIZE
    value: "2048"
  - name: SL_HEAP_SIZE
    value: "2048"
  - name: configMINIMAL_STACK_SIZE
    value: "1024"
  - name: CPU_CFG_TS_32_EN
    value: "1"
  - name: OS_CFG_DBG_EN
    value: "1"
  - name: OS_CFG_TS_EN
    value: "1"
  - name: OS_CFG_SCHED_ROUND_ROBIN_EN
    value: "1"
  - name: OS_CFG_STAT_TASK_EN
    value: "1"
  - name: OS_CFG_TASK_PROFILE_EN
    value: "1"
  - name: NVM3_DEFAULT_MAX_OBJECT_SIZE
    value: "204"
  # Config default - proprietary config
  - name: SL_RAIL_UTIL_INIT_INIT_COMPLETE_CALLBACK_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_BLE_SUPPORT_INST0_ENABLE
    value: "0"
  - name: SL_RAIL_UTIL_INIT_RADIO_CONFIG_SUPPORT_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_PROTOCOLS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_PROTOCOL_INST0_DEFAULT
    value: SL_RAIL_UTIL_PROTOCOL_PROPRIETARY
  - name: SL_RAIL_UTIL_INIT_CALIBRATIONS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_CALIBRATION_TEMPERATURE_NOTIFY_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_CALIBRATION_ONETIME_NOTIFY_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_DATA_FORMATS_INST0_ENABLE
    value: "1"
    # Config required events
  - name: SL_RAIL_UTIL_INIT_EVENTS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_CAL_NEEDED_INST0_ENABLE
    value: "1"
  # Config required auto state transitions
  - name: SL_RAIL_UTIL_INIT_TRANSITION_INST0_TX_SUCCESS
    value: RAIL_RF_STATE_RX
  - name: SL_RAIL_UTIL_INIT_TRANSITION_INST0_TX_ERROR
    value: RAIL_RF_STATE_RX
  - name: SL_RAIL_UTIL_INIT_TRANSITION_INST0_RX_SUCCESS
    value: RAIL_RF_STATE_RX
  - name: SL_RAIL_UTIL_INIT_TRANSITION_INST0_RX_ERROR
    value: RAIL_RF_STATE_RX
  - name: SL_RAIL_UTIL_INIT_TRANSITIONS_INST0_ENABLE
    value: "1"
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  # Misc. config
  - condition: [hardware_board_has_eff]
    name: SL_RAIL_UTIL_PA_SELECTION_SUBGHZ
    value: RAIL_TX_POWER_MODE_SUBGIG_EFF_25DBM
  - condition: [hardware_board_has_eff]
    name: SL_RAIL_UTIL_PA_SELECTION_OFDM
    value: RAIL_TX_POWER_MODE_OFDM_PA_EFF_25DBM
  - condition: [hardware_board_has_eff]
    name: SL_RAIL_UTIL_PA_CALIBRATION_ENABLE
    value: "1"
  - condition:
      [device_generic_family_efr32xg25, hardware_board_default_rf_band_470]
    name: SL_DEVICE_INIT_RFFPLL_BAND
    value: "1"
  - condition:
      [device_generic_family_efr32xg25, hardware_board_default_rf_band_450]
    name: SL_DEVICE_INIT_RFFPLL_BAND
    value: "0"
  # Config PRS for most Series 2 test devices
  # EXP_HEADER_15/16
  - name: RADIOPRS_RX_ACTIVE_SOURCESEL
    value: "PRS_RACL_RX"
  - name: RADIOPRS_FRAMEDET_SOURCESEL
    value: "PRS_MODEML_FRAMEDET"
  # p group 0
  - name: RADIOPRS_RX_ACTIVE_CHANNEL
    value: "6"
    condition: [primary_prs_group_0]
  - name: RADIOPRS_RX_ACTIVE_PORT
    value: "gpioPortC"
    condition: [primary_prs_group_0]
  - name: RADIOPRS_RX_ACTIVE_PIN
    value: "5"
    condition: [primary_prs_group_0]
  # p group 1
  - name: RADIOPRS_RX_ACTIVE_CHANNEL
    value: "0"
    condition: [primary_prs_group_1]
  - name: RADIOPRS_RX_ACTIVE_PORT
    value: "gpioPortB"
    condition: [primary_prs_group_1]
  - name: RADIOPRS_RX_ACTIVE_PIN
    value: "2"
    condition: [primary_prs_group_1]
  # p group 2
  - name: RADIOPRS_RX_ACTIVE_CHANNEL
    value: "0"
    condition: [primary_prs_group_2]
  - name: RADIOPRS_RX_ACTIVE_PORT
    value: "gpioPortB"
    condition: [primary_prs_group_2]
  - name: RADIOPRS_RX_ACTIVE_PIN
    value: "15"
    condition: [primary_prs_group_2]
  # p group 0 - override
  - name: RADIOPRS_RX_ACTIVE_CHANNEL
    value: "6"
    condition: [primary_prs_group_0_ov]
  - name: RADIOPRS_RX_ACTIVE_PORT
    value: "gpioPortC"
    condition: [primary_prs_group_0_ov]
  - name: RADIOPRS_RX_ACTIVE_PIN
    value: "5"
    condition: [primary_prs_group_0_ov]
  # p group 1 - override
  - name: RADIOPRS_RX_ACTIVE_CHANNEL
    value: "0"
    condition: [primary_prs_group_1_ov]
  - name: RADIOPRS_RX_ACTIVE_PORT
    value: "gpioPortB"
    condition: [primary_prs_group_1_ov]
  - name: RADIOPRS_RX_ACTIVE_PIN
    value: "2"
    condition: [primary_prs_group_1_ov]
  # p group 2 - override
  - name: RADIOPRS_RX_ACTIVE_CHANNEL
    value: "0"
    condition: [primary_prs_group_2_ov]
  - name: RADIOPRS_RX_ACTIVE_PORT
    value: "gpioPortB"
    condition: [primary_prs_group_2_ov]
  - name: RADIOPRS_RX_ACTIVE_PIN
    value: "15"
    condition: [primary_prs_group_2_ov]

ui_hints:
  highlight:
    - path: config/rail/radio_settings.radioconf
